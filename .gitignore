# ============================================================
# Python 编译缓存
# ============================================================
__pycache__/
*.py[cod]
*$py.class

# ============================================================
# 运行数据与本地数据库（本机生成，禁止提交）
# 首次启动时 server.py / indexer_engine.py 会自动重建这些目录
# ============================================================
data/database/*.db
data/database/*.db-wal
data/database/*.db-shm
data/lancedb/
data/scan/scan_result.json
data/scan/compressed_scan_result.md
data/asset_security_levels.json
# 灾备清单的轮转备份（本机生成，禁止提交）
data/asset_security_levels.json.bak
# 对话记录：完整记录逐行落盘，一份对话一个时间戳文件（本机生成，禁止提交）
data/chat/
data/*.tmp

# ============================================================
# 运行期产生的物理资产（撤销备份快照 / 临时工作区）
# ============================================================
.local_agent_undo_backups/

# 临时工作区（一次性探针、诊断脚本、中间产物）不入库
_tmp_analysis/
_tmp_level1/
_tmp_level2/
_tmp_level3/

# ============================================================
# 配置文件（含真实 API Key、主密码散列与系统绝对路径，绝不提交）
# ============================================================
config/API_config.json
config/config.json
config/*.bak
config/*.local.json

# ============================================================
# 虚拟环境与 IDE
# ============================================================
venv/
.venv/
env/
.idea/
.vscode/
*.log

# ============================================================
# 测试与工具缓存
# ============================================================
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# pytest / 临时文件目录（部分受限环境下无法删除，统一忽略）
.test_tmp/
